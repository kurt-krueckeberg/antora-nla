#!/usr/bin/env bash
set -e

echo "=== Antora Build Started: $(date) ==="
#
#
# 1. CLEAN PREVIOUS BUILD
#
echo "Cleaning previous build..."
rm -rf /home/kurt/antora-nla/public

#
# 2. GIT PULL FROM REPO
#
echo "Updating antora-nla repo..."
cd /home/kurt/antora-nla
git pull

#
# 3. RUN ANTORA BUILD
#
echo "Running Antora build..."
cd /home/kurt/antora-nla

# Using npx directly (cleaner, safer, systemd-friendly)
npx --max-old-space-size=4096 antora local-playbook.yml

#
# 4. COPY FONTS
#
echo "Copying fonts..."
cp /home/kurt/antora-nla/fonts/* \
   /home/kurt/antora-nla/public/_/font/

#
# 5. DEPLOY TO WEB DIRECTORY
# (kurt must own this directory — no sudo in automated scripts)
#
echo "Deploying to /var/www/krueckeberg.org/nla..."
rm -rf /var/www/krueckeberg.org/nla/*
cp -r /home/kurt/antora-nla/public \
      /var/www/krueckeberg.org/nla

echo "=== Antora Build Completed: $(date) ==="
